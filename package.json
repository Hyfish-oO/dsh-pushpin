{
  "name": "dsh-pushpin",
  "version": "0.1.0",
  "type": "module",
  "description": "Pin the whole DeepSeek Harness window above other windows from a pushpin in the title bar. Windows, Linux X11 and macOS (yabai).",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "scripts/pin-server.ps1",
    "scripts/pin-linux.sh",
    "scripts/pin-macos.sh",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "always-on-top",
    "window-pin",
    "windows",
    "linux",
    "macos"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Hyfish-oO/dsh-pushpin"
  },
  "bugs": {
    "url": "https://github.com/Hyfish-oO/dsh-pushpin/issues"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "check": "node scripts/publish-check.mjs"
  }
}
